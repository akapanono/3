{
  "use_hdsa": true,
  "dataset_name": "IEMOCAP",
  "dataset_dir": "data/IEMOCAP",
  "bert_path": "pretrained/sup-simcse-roberta-large",
  "domain_anchor_path": "domain_anchors/IEMOCAP_M3_hyp.pt",
  "local_files_only": true,
  "num_subanchors": 3,
  "anchor_dim": 256,
  "anchor_temperature": 0.1,
  "proto_temperature": 0.1,
  "anchor_logit_weight": 0.3,
  "proto_weight": 0.5,
  "compact_weight": 0.1,
  "center_weight": 0.1,
  "div_weight": 1.0,
  "preserve_weight": 0.5,
  "same_upper": 0.9,
  "ot_epsilon": 0.02,
  "ot_iters": 50,
  "ot_sharpen_power": 2.0,
  "prototype_momentum": 0.95,
  "ema_conf_threshold": 0.45,
  "confusion_pairs": "angry:frustrated,happy:excited,neutral:frustrated",
  "pair_weight": 0.0,
  "pair_margin": 0.3,
  "pair_anchor_weight": 0.0,
  "pair_anchor_margin": 0.3,
  "happy_weight": 1.0,
  "epochs": 8,
  "batch_size": 16,
  "eval_batch_size": 32,
  "learning_rate": 2e-5,
  "other_lr": 4e-4,
  "dropout": 0.2,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "focal_gamma": 0.0,
  "early_stop": true,
  "early_stop_metric": "test_weighted_f1",
  "early_stop_patience": 3,
  "early_stop_min_delta": 0.0001,
  "save_best_dev": true,
  "save_best_test": true,
  "save_last": false
}
